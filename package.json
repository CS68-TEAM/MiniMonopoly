{
    "name": "mini-monopoly-tui",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    
    "scripts": {
        "start": "bun run src/main.ts",
        "test": "bun test",
        "build": "bun build ./src/main.ts --compile --target bun-windows-x64 --external blessed --outfile ./dist/Monopoly.exe",
        "check": "tsc --noEmit",
        "format": "prettier --write --tab-width 4",
        "format:check": "prettier --check --tab-width 4"
    },
    
    "dependencies": {
        "@types/blessed": "^0.1.25",
        "blessed": "^0.1.81"
    },
    "devDependencies": {
        "@types/bun": "^1.4.1",
        "prettier": "^3.9.8",
        "typescript": "^5.6.3"
    }
}
